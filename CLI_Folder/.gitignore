# =========================================================
# AE RENEWABLE — GIT IGNORE
# =========================================================

# Environment / secrets
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime
pids/
*.pid
*.seed
*.pid.lock

# Uploads
backend/uploads/*
!backend/uploads/.gitkeep

# Temporary files
tmp/
temp/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Build / coverage
dist/
build/
coverage/

# Database dumps
*.sql.gz
*.dump
*.backup