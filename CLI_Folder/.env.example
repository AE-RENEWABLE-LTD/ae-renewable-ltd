# =========================================================
# AE RENEWABLE LTD — ENVIRONMENT CONFIGURATION (VERCEL)
# =========================================================

NODE_ENV=production
PORT=5000

# Cloud PostgreSQL (Neon / Supabase / Vercel Postgres)
# Note: append ?sslmode=require for cloud databases
DATABASE_URL=postgresql://username:password@your-host.neon.tech/ae_renewable?sslmode=require

# Secure JWT signing secret
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# Your live Vercel deployment URL
CLIENT_URL=https://your-project.vercel.app

# SMTP Email Dispatch (Gmail or custom SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=a.e.renewablesolution@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM="AE Renewable Ltd <a.e.renewablesolution@gmail.com>"
