# =========================================================
# AE RENEWABLE LTD - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and configure your variables
# =========================================================

NODE_ENV=production
PORT=5000

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://username:password@localhost:5432/ae_renewable

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Application URL
CLIENT_URL=http://localhost:5000

# Email SMTP Credentials (Gmail or SMTP provider)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM="AE Renewable Ltd <your_email@gmail.com>"
