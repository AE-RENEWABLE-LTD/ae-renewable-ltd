{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "admin/**",
          "client/**",
          "installer/**",
          "arde/**",
          "public/**",
          "uploads/**",
          "database/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/automation",
      "schedule": "*/30 * * * *"
    }
  ]
}
