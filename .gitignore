# =========================================================
# AE RENEWABLE LTD - ROOT GITIGNORE
# =========================================================

# Secrets and environment files
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example

# Node dependencies
node_modules/
**/node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Uploads & Media
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep

# Temporary & backup files
*.bak
*.backup*
*.before-*
*.broken-*
installer_backup/
**/installer_backup/
scratch/
**/scratch/
tmp/
temp/

# OS and Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Build outputs
dist/
build/
coverage/

# Database dumps
*.sql.gz
*.dump
*.backup
